# Kopier til .env og justér efter din Supabase-instans.
# Next.js læser .env filen automatisk i dev-modus.
# Kør: npm run dev

# Supabase (fra https://app.supabase.com → Settings → API → Service Role)
# SERVICE ROLE key (secret) — ikke anon/publishable key!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
