# Kopier til .env og justér efter behov.

# Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=wedosalesform
PGUSER=
PGPASSWORD=

# Alternativ: fuld forbindelsesstreng (overskriver PG*-variabler)
# DB_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# API
PORT=4000
WDS_CVR=

# Kør migrationer automatisk når serveren starter
AUTO_MIGRATE=true
